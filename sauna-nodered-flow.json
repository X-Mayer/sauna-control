  {
    "id": "3",
    "type": "function",
    "z": "1",
    "name": "Temperature Logic",
    "func": "var currentTemp = msg.payload;\nvar desiredTemp = global.get('desiredTemp') || 70; // Default to 70°C\n\nif (currentTemp < desiredTemp) {\n    // Turn on heating, turn off cooling\n    return [{payload: true}, {payload: false}];\n} else if (currentTemp > desiredTemp) {\n    // Turn off heating, turn on cooling\n    return [{payload: false}, {payload: true}];\n} else {\n    // Maintain current state\n    return [{payload: false}, {payload: false}];\n}",
    "outputs": 2,
    "noerr": 0,
    "x": 350,
    "y": 100,
    "wires": [
      [
        "4"
      ],
      [
        "5"
      ]
    ]
  },
